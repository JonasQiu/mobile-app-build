  "version": "0.1.0",
  "description": "Tool-neutral OpenSpec workflow for multi-platform specification-driven delivery",
  "private": true,
  "bin": {
    "mobile-spec": "bin/mobile-spec.js"
  },
  "files": [
    "schemas",
    "scripts",
    "bin",
    ".agents"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "js-yaml": "^4.1.0",
    "mustache": "^4.2.0"
  },
  "keywords": [
    "openspec",
    "schema",
    "mobile-spec",
    "spec-driven"
  ],
  "license": "MIT",
  "devDependencies": {
    "@inquirer/testing": "^3.3.9",
    "@nx/js": "^22.7.5",
    "nx": "^22.7.5"
